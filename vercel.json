{
  "rewrites": [
    { "source": "/sw.js", "destination": "/sw.js" },
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    { "source": "/workbox-([^/]+)\\.js", "destination": "/workbox-$1.js" },
    { "source": "/catcafe/(.*)", "destination": "/catcafe/$1" },
    { "source": "/icon-96.png", "destination": "/icon-96.png" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/catcafe/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw\\.js|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
