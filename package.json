{
  "name": "snackchat",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host --port 3000",
    "dev:ngrok": "HMR_HOST=rework-regain-prong.ngrok-free.dev vite dev --host --port 3000",
    "preview-https": "export NODE_EXTRA_CA_CERTS=\"$(pwd)/public/rootCA.pem\" && vite build --mode development && vite preview --host 0.0.0.0",
    "ngrok": "ngrok http https://localhost:3000 --url https://rework-regain-prong.ngrok-free.dev --traffic-policy-file ngrok/policy.yaml",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@posthog/react": "^1.10.5",
    "@react-oauth/google": "^0.13.5",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.38.0",
    "nitro": "^3.0.260610-beta",
    "posthog-js": "^1.425.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-webcam": "^7.2.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tiny-invariant": "^1.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.43",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "core-js@3.50.0": true
  }
}
